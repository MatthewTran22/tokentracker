# ========== Required ==========

# Postgres connection string. For Neon/Supabase use the POOLED host.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# >=32 bytes of random; HMAC pepper for session + ingest token hashes.
# Rotating this invalidates every session and every ingest token.
#   AUTH_SECRET=$(openssl rand -hex 32)
AUTH_SECRET=

# ========== Optional ==========

# "1" when serving over HTTPS. Enables Secure cookie flag, sends HSTS,
# and hides /docs + /redoc + /openapi.json. Leave "0" for local HTTP dev.
COOKIE_SECURE=0

# "1" when behind a trusted reverse proxy (Vercel, Cloudflare, Fly.io, nginx).
# Rate limits will key on x-real-ip / cf-connecting-ip / leftmost x-forwarded-for
# instead of the direct connection IP. Never enable without a trusted proxy
# in front — any client could spoof the header.
TRUST_PROXY=0

# "1" when DATABASE_URL points at a transaction-mode pooler (Neon pooler host,
# Supabase pooler, raw pgbouncer). Disables psycopg3's prepared-statement
# caching so prepares don't leak across pooled transactions.
DB_DISABLE_PREPARE=0

# Max Postgres connections per app instance. Keep low (1-2) on serverless so
# fan-out doesn't exhaust the server; raise (10+) only on a single long-lived
# VM with no downstream pooler.
DB_POOL_MAX=2
