# Copy to .env and fill in. This file is read by BOTH compose files:
# docker-compose.yml (local dev) and docker-compose.prod.yml (the Oracle VM).
#
# IMPORTANT: with either compose file the app's DATABASE_URL is set FOR you
# (dev -> local `dev` password; prod -> built from POSTGRES_PASSWORD below), so
# you do NOT set DATABASE_URL here. Only the standalone section at the bottom
# needs it.

# ========== Always required ==========

# >=32 bytes of random; HMAC pepper for session + ingest-token hashes.
# Rotating it invalidates every session and every ingest token.
#   AUTH_SECRET=$(openssl rand -hex 32)
AUTH_SECRET=

# ========== Production (Oracle VM) ==========

# On-box Postgres password. Prod compose interpolates it into the db container
# AND the app's DATABASE_URL (the `:?` guard fails the deploy if it's unset).
# Dev ignores this — the dev db uses a fixed `dev` password.
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)
POSTGRES_PASSWORD=

# Hostname the TLS cert is issued for and nginx serves on. Drives nginx
# server_name, cert paths, and certbot issuance. A DNS A record for it must
# point at the VM. Required by prod compose (`:?` guarded).
DOMAIN=tokentracker.example.com

# Address Let's Encrypt uses for renewal/expiry notices (optional). Read by
# nginx/init-letsencrypt.sh during the one-time TLS bootstrap.
LETSENCRYPT_EMAIL=you@example.com

# ========== App behavior (flip these ON in prod) ==========

# "1" when served over HTTPS (behind the VM's nginx). Adds the Secure cookie
# flag + HSTS and hides /docs, /redoc, /openapi.json. "0" for local HTTP dev.
COOKIE_SECURE=0

# "1" only when behind a trusted reverse proxy (the VM's nginx). Rate limits
# then key on X-Real-IP / X-Forwarded-For instead of the socket IP. Safe in
# prod because the app has no host port — every request arrives via nginx.
# Never enable without a trusted proxy; any client can spoof the header.
TRUST_PROXY=0

# Max Postgres connections per app instance. The single VM talks straight to
# local Postgres, so 10 is fine there; keep low (1-2) on serverless / behind a
# transaction pooler.
DB_POOL_MAX=2

# "1" only when DATABASE_URL points at a transaction-mode pooler (pgbouncer,
# Neon/Supabase pooler). The on-box VM Postgres is a direct connection -> 0.
DB_DISABLE_PREPARE=0

# ========== Standalone only (running the app WITHOUT docker compose) ==========

# Compose sets DATABASE_URL for you (see top). Uncomment this ONLY if you run
# uvicorn directly and must point it at a database yourself. For a transaction
# pooler, also set DB_DISABLE_PREPARE=1.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
