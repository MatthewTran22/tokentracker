DATABASE_URL=postgresql://tokentracker:dev@db:5432/tokentracker
# >=32 bytes of random. Rotate invalidates all sessions + ingest tokens.
AUTH_SECRET=replace-me-with-openssl-rand-hex-32
# "1" in production (HTTPS) — also enables HSTS and hides /docs+/redoc+/openapi.json.
COOKIE_SECURE=0
# "1" behind a trusted reverse proxy (Vercel/Cloudflare/Fly.io/nginx) so rate limits use
# the client IP from x-real-ip or x-forwarded-for. Never enable without a trusted proxy
# in front — anyone could spoof the header.
TRUST_PROXY=0
# Max connections per app instance. Keep low (1-2) on serverless and rely on a
# downstream pooler. Higher (10+) only on a single long-lived VM with no pooler.
DB_POOL_MAX=2

